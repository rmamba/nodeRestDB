{
  "name": "node-rest-db",
  "version": "0.1.4",
  "description": "Node.js REST DB",
  "apidoc": {
    "title": "Node.js REST DB",
    "url": "https://node.restdb.mambix.com"
  },
  "main": "index.js",
  "scripts": {
    "start": "yarn run build:live",
    "prebuild": "tslint -c tslint.json -p tsconfig.json --fix",
    "build": "tsc -p .",
    "build:live": "nodemon --watch 'src/**/*.ts' --exec ts-node src/index.ts",
    "docs": "./node_modules/.bin/apidoc -i src/API/ -o docs/",
    "test": "npx jest"
  },
  "author": "rmamba@gmail.com",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.3",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.6.4",
    "apidoc": "^0.52.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^2.0.19",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.1",
    "tslint": "^6.1.3",
    "typescript": "^4.7.4"
  },
  "nyc": {
    "exclude": [
      "test/**",
      "modules/test/**"
    ]
  },
  "jest": {
    "reporters": [
      "default",
      "jest-junit"
    ],
    "testResultsProcessor": "jest-junit"
  }
}
